{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IRT Visual Benchmark Judgment",
  "type": "object",
  "required": [
    "judgment_id",
    "response_id",
    "task_id",
    "stimulus_id",
    "target_model_name",
    "judge_model_name",
    "scores",
    "error_margins",
    "total_score",
    "max_possible_score",
    "normalized_score"
  ],
  "properties": {
    "judgment_id": {"type": "string"},
    "response_id": {"type": "string"},
    "task_id": {"type": "string"},
    "stimulus_id": {"type": "string"},
    "target_model_name": {"type": "string"},
    "judge_model_name": {"type": "string"},
    "scores": {"type": "object"},
    "error_margins": {"type": "object"},
    "total_score": {"type": "number"},
    "max_possible_score": {"type": "number"},
    "normalized_score": {"type": "number"},
    "provided_psychometric_rationale": {"type": "boolean"},
    "judge_reasoning": {"type": "string"}
  }
}
